[Unit]
Description=Проверка созревших напоминаний по лидам

[Timer]
# Каждые пять минут. Чаще незачем: напоминание ставится в часах, и разница
# между «через 4 часа» и «через 4 часа и 3 минуты» никого не спасает и не
# губит. Реже — и напоминание «позвонить через полчаса» опаздывает заметно.
OnBootSec=3min
OnUnitActiveSec=5min

# Persistent здесь не нужен и был бы вреден: после суток простоя сервера
# он выстрелил бы разом всей накопленной очередью.
[Install]
WantedBy=timers.target
