[Unit]
Description=Чтение публичных чатов для холодного поиска лидов
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/devuz/scout
EnvironmentFile=/opt/devuz/.env

# Node сам по себе игнорирует HTTP_PROXY и HTTPS_PROXY — флаг включает их
# разбор для fetch. У сайта он стоит в Dockerfile, но скаут живёт не в
# образе, а на хосте под systemd, и та строка до него не доходит.
#
# Без флага ломается ровно половина скаута, и ломается тихо. Чтение чатов
# работает: MTProto идёт через собственный мост, которому переменные не
# нужны. А разбор сообщений и сигнал оператору — это обычный fetch к
# Anthropic и к api.telegram.org, и напрямую с этого сервера не отвечает ни
# тот, ни другой. В журнале это выглядит как «увидел 40, до модели дошло 6,
# разобрано 0» — то есть как будто модель ничего не нашла.
#
# Строка идёт после EnvironmentFile намеренно: systemd применяет их сверху
# вниз, и так флаг переживает случайный NODE_OPTIONS в .env.
Environment=NODE_OPTIONS=--use-env-proxy

ExecStart=/usr/bin/npm start

# Долгоживущий слушатель, а не задача по расписанию: перезапускаем при
# любом падении. Пауза, чтобы при неверной сессии не крутиться в цикле
# сотни раз в минуту и не выглядеть для Telegram как перебор.
Restart=always
RestartSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
