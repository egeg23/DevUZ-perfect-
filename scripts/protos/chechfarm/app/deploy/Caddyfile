# HTTPS для сайта CZECHFARM: Caddy сам получает и продлевает сертификат
# Let's Encrypt на домен из DOMAIN (нужна запись A на этот сервер и
# открытые 80 и 443). Сайт — контейнер czechfarm-app в сети czechfarm.
{
	admin off
}

# www.<домен> — сразу на основной адрес (нужна своя запись A или CNAME).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy czechfarm-app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
