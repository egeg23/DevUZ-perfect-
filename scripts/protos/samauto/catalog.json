 "faq": [
  {
   "q": "Zavoddan gaz bilan jihozlangan avtomobilni sotib olsa bo‘ladimi?",
   "a": "Zavod ikki turdagi transport vositalarini ishlab chiqaradi: dizel yoki siqilgan tabiiy gaz (metan, CNG). Samarqand avtomobil zavodi yoqilg‘i tizimining dizeldan gazga qayta jihozlash bilan shug‘ullanmaydi."
  },
  {
   "q": "Maxsus buyurtma asosida mahsulot harid qilishim uchun kimga murojaat qilishim kerak?",
   "a": "Maxsus buyurtma bo‘yicha mahsulot harid qilib olish uchun hududingizda joylashgan dilerlik markazlariga xat bilan murojaat qilishingiz mumkin."
  },
  {
   "q": "Zavod o‘z mahsulotiga qanday kafolat beradi?",
   "a": "Zavod o‘z mahsulotlariga 50 000 km yoki 1 yil va faqatgina D-MAX uchun 100 000 km yoki 2 yilgacha kafolat beradi, qaysi biri birinchi kelishiga qarab."
  },
  {
   "q": "Mahsulot narxi Samarqanddagi dilerlik markazlarida va boshqa hududlarda joylashgan dilerlik markazlaridagi narxlar bilan farq qiladimi?",
   "a": "\"Samauto\" MChJ QK tayyor mahsulotining narxi Ozbekistonning barcha hududlarida bir xil."
  },
  {
   "q": "Men O‘zbekistondan emasman, sizning mahsulotingizni harid qilmoqchiman. Kimga murojaat qilishim mumkin?",
   "a": "O‘z murojaatingizni korxonamizning tashqi savdo bo‘limining: export@samauto.uz elektron pochta manziliga yuborishingiz mumkin."
  },
  {
   "q": "Bugungi vaqtda mahsulotni yetkazib berish muddati qancha?",
   "a": "Avtomobilni yetkazib berish muddati: rusum, kuzov turi va ushbu turdagi avtomobillarning buyurtmalar soniga bog‘liq."
  },
  {
   "q": "Boshqa hududda joylashgan dilerdan avtomobil sotib olish mumkinmi?",
   "a": "\"SamAuto\" MChJ QK mahsulotini istalgan rasmiy dilerlik markazidan harid qilishingiz mumkin. Biroq, ishlab chiqaruvchi-zavod tomonidan kafolat davrida xizmat ko‘rsatish qulay bo‘lishi uchun hududingizdagi dilerlik markazlaridan harid qilishingizni tavsiya qilamiz."
  },
  {
   "q": "Mahsulotlarni lizing yoki kreditga sotib olish mumkinmi?",
   "a": "\"SamAuto\" MChJ QK mahsulotini ham lizingga, ham kreditga harid qilishingiz mumkin. Buning uchun sizga eng qulay shartlarni taklif qilgan bank yoki lizing kompaniyasini tanlash orqali amalga oshirishingiz mumkin."
  },
  {
   "q": "Nima uchun avtomobillarga texnik xizmat ko‘rsatish dilerlik markazlarida amalga oshirilishi kerak?",
   "a": "SamAuto\" MChJ QK dilerlik markazlari tarmoglida ishlaydigan ustalar (mexaniklar, etektriklar va boshqalar) ISUZU standartlariga muvofiq mahsulotlar bo’yicha maxsus tayyorgartikdan o’tadilar, muntazam ravishda o’z malakalarini zavodda oshiradilar. Avtomobillarni diaqnostika qilish va ta’mirtashda ular maxsus asbob-uskunalar hamda iihozlardan foydalanadilar."
  },
  {
   "q": "Zavod qanday mahsulot ishlab chiqaradi?",
   "a": "Samarqand avtomobil zavodi ISUZU shassisi negizida shahar va shaharlararo avtobuslari, yuk (yuk koʻtarish qobiliati 2,5 tonnadan 20 tonnagacha), maxsus avtomobillarni (yong’in oʻchirish, kommunal xo’jaliklar uchun, tez tibbiy yordam avtomobillari va boshqalar) hamda pikaplar ishlab chiqaradi."
  },
  {
   "q": "Mahsulotni zavodning o‘zidan to‘g‘ridan-to‘g‘ri sotib olsa boʻladimi?",
   "a": "Zavod mahsutotini faqat hududiy dilerik markazlaridan sotib olishingiz mumkin. SamAutoning dilerlik markazlari 0 zbekistonning barcha viloyatlarida va chet ellarda mavjud."
  },
  {
   "q": "ISUZU dvigatelining resursi nima?",
   "a": "ISUZU dvigatelining resursi kamida 1 million kilometrni tashkil etadi."
  },
  {
   "q": "Avtomobillarning texnik xususiyatlari haqida qayerdan ko‘proq ma‘lumot olsam bo‘ladi?",
   "a": "Sizni qiziqtirgan avtobus/yuk mashinasini tanlab, batafsil texnik xususiyatlarni veb-saytda topishingiz mumkin."
  },
  {
   "q": "Mahsulotlarni mahalliylashtirish darajasi qanday?",
   "a": "Mahsulotlarni mahalliylashtirish 20 foizdan ortiq (GPL va Iqtisodiyot vazirligi usuli bo‘yicha 21,8 foiz avtobus va 21 foiz yuk avtomobillari; 30,1 foiz avtobus va 26,7 foiz yuk avtomobillari ST-1 usuli bo‘yicha)"
  },
  {
   "q": "BVP ehtiyot qismlari nima?",
   "a": "BVP (eng yaxshi qiymatli qismlarning qisqartmasi) Isuzu Motors sifat sertifikatidan o‘tgan zavodlarda ishlab chiqarilgan Isuzu asl qismlari. Ularning Yaponiyadagi zavodlarda yaratilgan qismlardan asosiy farqi bir xil sifat darajasida past narxda."
  }
 ],
