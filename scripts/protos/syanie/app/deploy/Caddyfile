# HTTPS для сайта клиники: Caddy сам получает и продлевает сертификат
# Let's Encrypt на домен из DOMAIN (нужна запись A на этот сервер и
# открытые 80 и 443). Сайт — контейнер syanie-app в сети syanie.
{
	admin off
}

# Прежние адреса сайта (new.<домен> на время проверки) — 301 на основной:
# список пишет remote.sh в /data/redirect.caddy, нет файла — нет и блока.
import /data/redirect*.caddy

# www.<домен> — сразу на основной адрес (нужна своя запись A или CNAME).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy syanie-app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
