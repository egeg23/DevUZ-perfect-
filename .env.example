# ─── Сайт ────────────────────────────────────────────────────────────────────
# Канонический адрес. Меняется одной строкой при переезде на другой домен.
NEXT_PUBLIC_SITE_URL=https://devuz.studio

# ─── Claude (AI-менеджер первой линии) ───────────────────────────────────────
ANTHROPIC_API_KEY=
# По умолчанию claude-opus-5. Можно переключить на claude-sonnet-5 —
# он примерно в 1.7 раза дешевле на вход и выход при похожем качестве
# в коротком квалификационном диалоге.
ANTHROPIC_MODEL=claude-opus-5
# Разбор законченной переписки надзирателем: модель попроще — она не пишет
# клиенту, а вычитывает факты из ленты.
ANTHROPIC_REVIEW_MODEL=claude-haiku-4-5-20251001
# Адрес API. Менять нужно только если запросы уходят через собственный шлюз:
# Anthropic обслуживает не все страны, и сервер в неподдерживаемой стране
# получает 403 ещё до того, как запрос дойдёт до API.
# Проверить страну сервера: curl -s https://ipinfo.io/country
# Список стран: https://www.anthropic.com/supported-countries
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Прокси для исходящих запросов ───────────────────────────────────────────
# Нужен, если сервер стоит в стране, которую Anthropic не обслуживает: запрос
# оттуда отвергается на границе с 403, не доходя до API, — ключ при этом
# исправен. Прокси должен стоять в поддерживаемой стране.
# Проверить страну сервера:  curl -s https://ipinfo.io/country
# Проверить, что помогло:    curl -s "https://ВАШ-ДОМЕН/api/health?deep=1"
# HTTPS_PROXY=http://user:pass@host:port
# HTTP_PROXY=http://user:pass@host:port
# NO_PROXY=127.0.0.1,localhost

# ─── Telegram (лид второго уровня) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Чат/канал отдела продаж. Для группы id отрицательный: -1001234567890
TELEGRAM_SALES_CHAT_ID=
# Произвольная строка. Тот же секрет передаётся в setWebhook как
# secret_token — так проверяется, что запрос действительно от Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Адрес Bot API. Задаётся только в тестах, чтобы подставить заглушку вместо
# настоящего Telegram; в проде оставить пустым.
# TELEGRAM_API_BASE=

# ─── Бриф с витрины (конструктор на globalex.maximov-tech.ru) ────────────────
# Витрина присылает сюда собранный клиентом заказ: пакет, допники, сумма.
# Общий секрет — та же строка в .env.local витрины как SHOWCASE_BRIEF_SECRET.
# Сгенерировать: openssl rand -hex 24. Пусто — /api/brief отвечает 503, и
# витрина шлёт бриф в Telegram сама, без ассистента в боте.
SHOWCASE_BRIEF_SECRET=
# Личный чат владельца. Заказы дороже порога уходят только сюда, а не в чат
# отдела продаж. Пусто — берётся Telegram id сотрудника с ролью admin из
# команды в панели. Нет ни того ни другого — крупный бриф падает в чат
# продаж с пометкой, что владелец не настроен.
TELEGRAM_OWNER_CHAT_ID=
# Порог в долларах, строго «больше». По умолчанию 10000.
BRIEF_OWNER_ONLY_FROM_USD=10000

# ─── Гарантия «ответ за 20 секунд» ───────────────────────────────────────────
# Каждый какой разговор получает скидку 30% за несработавшую гарантию.
# 3 — каждый третий (значение по умолчанию), 0 — механика выключена, гарантия
# остаётся честной и скидка выдаётся только при реальной задержке.
# Это решение про деньги: на тридцати процентах треть обращений — заметная
# доля маржи. Меняется без пересборки.
PROMISE_MISS_EVERY=3

# ─── Supabase (история диалогов, скоринг, статусы лидов) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# service_role — только на сервере, никогда не в NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Прямое подключение к базе. Нужно только ночным бэкапам (deploy/backup-db.sh
# читает эту строку из .env напрямую, минуя контейнер), приложение им не
# пользуется. Строка берётся в Supabase: Project Settings → Database →
# Connection string → Session pooler. Пока переменной нет, таймер бэкапов
# не включается — и база живёт без единой копии.
SUPABASE_DB_URL=

# ─── Напоминания по лидам ────────────────────────────────────────────────────
# Общий секрет, которым таймер systemd дёргает /api/reminders/sweep.
# Сгенерировать: openssl rand -hex 24
# Пусто — рассылка напоминаний не работает (и адрес закрыт для всех).
REMINDER_SWEEP_SECRET=

# Голос плановой смены: у неё нет ни одного внешнего инструмента, только
# bash, поэтому отчёт она отдаёт curl-ом на /api/shift/report с этим
# секретом в заголовке x-devuz-shift.
SHIFT_REPORT_SECRET=

# Чем ночная смена пишет разборы. Пусто — общей моделью сайта.
RAZBOR_MODEL=

# Чем смена определяет нишу сайта, которой нет в каталоге, и просит формы
# слова для заголовка. Один короткий ответ на сайт — платить за него как за
# статью незачем. Пусто — Sonnet.
RAZBOR_NICHE_MODEL=

# ─── Холодный поиск в чатах (TG Lead Scout) ──────────────────────────────────
# Канал, куда падают сигналы. Отдельный от чата отдела продаж: там брифы
# настоящих лидов, и смешивать их с холодной лентой — значит утопить первые
# во вторых. Пусто — сигналы копятся в базе, но никому не рассылаются.
TELEGRAM_SCOUT_CHANNEL_ID=

# Модель для разбора сообщений скаута. Пусто — берётся ANTHROPIC_MODEL.
# Задача — «спрос или нет», и на claude-opus-5 это дорого ($5/$25 за
# миллион токенов на вход/выход); claude-sonnet-5 — $2/$10, claude-haiku-4-5
# — $1/$5. Стоит попробовать на неделе и сравнить ленту.
# claude-fable-5-1 сюда ставить нельзя: разбор принудительно вызывает
# инструмент (tool_choice: tool), а эта модель на такое отвечает 400 — и
# скаут молча начнёт отдавать «разобрано 0».
SCOUT_MODEL=

# Модели по узлам. Пусто — берётся та, что выбрана в коде по замеру
# 21 сентября: письма и отбор скаута на Соннете (то же качество по нашим
# проверкам, втрое дешевле Опуса), разбор резюме и подсказки менеджеру —
# там же. Чат на сайте остаётся на Опусе: там продажа.
#
# Менять можно здесь и без выкатки: значение читается при запуске.
OUTREACH_MODEL=
HIRING_MODEL=
COACH_MODEL=

# Доступ к аккаунту, который читает чаты. api_id и api_hash берутся на
# https://my.telegram.org, строка сессии — одноразовым `npm run login`
# в папке scout/.
#
# SCOUT_SESSION равносильна доступу к аккаунту: с ней читают всё, что читает
# человек. В репозиторий не попадает, в мессенджере не пересылается.
SCOUT_API_ID=
SCOUT_API_HASH=
SCOUT_SESSION=

# Чаты через запятую: username, @username или числовой id.
# Скрипт только читает уже вступленные чаты — вступает человек, руками.
SCOUT_CHATS=

# Ниже какой оценки сигнал не показывать оператору. По умолчанию 60.
# Поднимают, когда в ленте появляется шум: доске объявлений нужен порог
# выше, чем клубу предпринимателей. Значение вне 1–100 игнорируется.
# SCOUT_MIN_SCORE=60

# ─── Реквизиты для счёта ─────────────────────────────────────────────────────
# Без этих четырёх переменных счёт покупателю выставится, но напечатать его
# будет нельзя: документ без расчётного счёта — это бумага, по которой не
# заплатить. Панель в таком случае говорит, чего именно не хватает.
#
# В репозитории их нет намеренно: расчётный счёт не секрет (его печатают на
# каждом счёте), но и в git ему делать нечего.
INVOICE_TAX_ID=
# Чем поставщик опознаётся: inn — ИНН (СТИР) резидента, pinfl — личный номер
# нерезидента, ведущего дело как ИП в Узбекистане. Пусто — inn.
# Подпись в счёте меняется вместе со значением: ПИНФЛ под заголовком «ИНН»
# бухгалтерия покупателя вернёт.
INVOICE_TAX_ID_KIND=inn
INVOICE_BANK_NAME=
INVOICE_BANK_ACCOUNT=
INVOICE_BANK_MFO=

# Нужны только для валютного перевода из-за рубежа.
INVOICE_BANK_SWIFT=
INVOICE_BANK_ADDRESS=

# Через сколько дней счёт считается просроченным. По умолчанию 14.
# Значение вне 1..180 игнорируется — это почти наверняка опечатка.
INVOICE_PAYMENT_DAYS=14

# ─── Выдача купленного кода ──────────────────────────────────────────────────
# Ключ, которым подписывается ссылка на скачивание. Не меньше 32 знаков —
# короткий ключ тут хуже отсутствующего, он создаёт видимость подписи, и
# поэтому просто выключает выдачу.
# Сгенерировать: openssl rand -hex 32
#
# Смена ключа обесценивает все выданные ссылки разом. Это аварийный рубильник,
# а не штатный отзыв: штатный — кнопка «отозвать доступ» на карточке заявки,
# она бьёт по одному заказу.
#
# Пусто — покупатель после оплаты видит «файл готовим» вместо кнопки.
DOWNLOAD_SIGNING_SECRET=

# ─── SEO / аналитика ─────────────────────────────────────────────────────────
# Ключ IndexNow: одним запросом уведомляет Bing и Яндекс об обновлениях.
INDEXNOW_KEY=

# Счётчик Яндекс.Метрики. Только номер, одними цифрами — он подставляется в
# вызов ym() числом, как в сниппете Яндекса. Что-нибудь кроме цифр гасит
# счётчик целиком: лучше ни одного просмотра, чем сломанный вызов, который
# молча не считает ничего.
#
# Та же оговорка про NEXT_PUBLIC_, что и ниже у тега Google: вшивается на
# сборке, дописать строку в .env мало — нужна выкатка.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Тег Google (gtag.js). Идентификатор ресурса GA4 — вида G-XXXXXXXXXX; тот же
# тег обслуживает и конверсии Google Ads, второй скрипт на сайт ставить не
# нужно.
#
# Важно: переменные с префиксом NEXT_PUBLIC_ вшиваются в клиентский бандл на
# сборке, а не читаются в рантайме. Дописать строку в .env мало — нужна
# пересборка, то есть выкатка. Без неё тега на сайте не появится, и Google
# будет показывать «тег не найден».
NEXT_PUBLIC_GA_ID=

# Трафик на дашборде владельца (вкладка «Трафик»). Это не счётчики на сайте —
# те выше, — а ключи, чтобы читать их статистику обратно. Только сервер.
#
# Метрика: OAuth-токен с доступом «Яндекс.Метрика: получение статистики»
# (приложение на oauth.yandex.ru, токен по ссылке authorize?response_type=token).
# Номер счётчика можно не задавать — возьмётся из NEXT_PUBLIC_YANDEX_METRIKA_ID.
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_ID=
# Google Analytics 4: числовой идентификатор ресурса (не G-…) и JSON-ключ
# сервисного аккаунта с ролью «Читатель» в ресурсе — одной строкой в base64:
#   base64 -w0 ключ.json
GA4_PROPERTY_ID=
GA_SERVICE_ACCOUNT=

GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ─── Сеть и запасные адреса ──────────────────────────────────────────────────
# Сервер в Узбекистане, а Anthropic эту страну не обслуживает: запрос
# отвергается на границе с 403, не доходя до API. Прокси — не ускорение,
# а единственный способ получить ответ модели. Пусто — идём напрямую.
HTTPS_PROXY=
HTTP_PROXY=
# Через прокси не ходим внутрь самого сервера: сюда попадают свипы и
# healthcheck, и заворачивать их наружу значит уронить их вместе с прокси.
NO_PROXY=127.0.0.1,localhost

# Запасные адреса API, если прямой хост станет недоступен. Пусто — обычные.
ANTHROPIC_BASE_URL=
TELEGRAM_API_BASE=

# ─── Холодный поиск ──────────────────────────────────────────────────────────
# Порог, ниже которого сигнал не показывают оператору. Пусто — из кода.
SCOUT_MIN_SCORE=
