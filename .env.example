# ─── Сайт ────────────────────────────────────────────────────────────────────
# Канонический адрес. Меняется одной строкой при переезде на другой домен.
NEXT_PUBLIC_SITE_URL=https://devuz.maximov-tech.ru

# ─── Claude (AI-менеджер первой линии) ───────────────────────────────────────
ANTHROPIC_API_KEY=
# По умолчанию claude-opus-5. Можно переключить на claude-sonnet-5 —
# он примерно в 1.7 раза дешевле на вход и выход при похожем качестве
# в коротком квалификационном диалоге.
ANTHROPIC_MODEL=claude-opus-5

# ─── Telegram (лид второго уровня) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Чат/канал отдела продаж. Для группы id отрицательный: -1001234567890
TELEGRAM_SALES_CHAT_ID=
# Произвольная строка. Тот же секрет передаётся в setWebhook как
# secret_token — так проверяется, что запрос действительно от Telegram.
TELEGRAM_WEBHOOK_SECRET=

# ─── Supabase (история диалогов, скоринг, статусы лидов) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# service_role — только на сервере, никогда не в NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# ─── SEO / аналитика ─────────────────────────────────────────────────────────
# Ключ IndexNow: одним запросом уведомляет Bing и Яндекс об обновлениях.
INDEXNOW_KEY=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
